{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>todd/renovate-config"],
  packageRules: [
    {
      description: "Bump the Go module directive across minor versions",
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
    },
    {
      description: "Keep the Go module, mise toolchain, and Dockerfile builder image aligned",
      matchDepNames: ["go", "golang"],
      groupName: "Go toolchain",
      groupSlug: "go-toolchain",
    },
  ],
  postUpdateOptions: ["gomodTidy"],
}
