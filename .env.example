# Copy to .env and fill in your values.
# docker compose reads .env automatically.

MIKROTIK_BASEURL=https://192.168.88.1
MIKROTIK_USERNAME=dexd
MIKROTIK_PASSWORD=
DEFAULT_TARGET=192.0.2.10

# Optional overrides (defaults shown)
# MIKROTIK_SKIP_TLS_VERIFY=false
# MIKROTIK_CA_CERT=
# TXT_OWNER=dexd
# TXT_PREFIX=
# POLICY=sync
# DEFAULT_TTL=auto
# RECONCILE_INTERVAL=5m
# LOG_LEVEL=info
# LOG_FORMAT=text
# DRY_RUN=false
# METRICS_ADDR=:8080

# Optional container labels:
# dexd.target=<ip-or-hostname>
# dexd.routers.<router>.target=<ip-or-hostname>
# dexd.routers.<router>.hostnames=<hostname>[,<hostname>...]
# dexd.routers.<router>.extra-hostnames=<hostname>[,<hostname>...]
# dexd.routers.<router>.skip=true
# dexd.hosts.<name>.hostnames=<hostname>[,<hostname>...]
# dexd.hosts.<name>.target=<ip-or-hostname>
# dexd.hosts.<name>.skip=true
